+/*
+ * VoidBR: --overwrite <glob> / overwrite=<glob> (como o pacman). Cada
+ * padrão é testado contra o caminho do pacote ("/usr/bin/foo"), o mesmo
+ * sem a barra inicial e o caminho dentro do rootdir; vale o último padrão
+ * que casar com qualquer um deles (`!' nega, como no noextract). Diretório
+ * nunca é sobrescrito por arquivo nem arquivo por diretório (o pacman
+ * também recusa).
+ */
+static bool
+can_overwrite_file(struct xbps_handle *xhp, const char *file,
+		enum type type, enum type oldtype)
+{
+	char rooted[XBPS_MAXPATH];
+	const char *paths[3];
+	unsigned int npaths = 0;
+	bool match = false;
+
+	if (xhp->overwrite == NULL)
+		return false;
+	if (type == TYPE_DIR || oldtype == TYPE_DIR)
+		return false;
+
+	paths[npaths++] = file;
+	if (file[0] == '/')
+		paths[npaths++] = file + 1;
+	if (xbps_path_join(rooted, sizeof(rooted), xhp->rootdir, file,
+	    (char *)NULL) != -1)
+		paths[npaths++] = rooted;
+
+	for (unsigned int i = 0; i < xbps_array_count(xhp->overwrite); i++) {
+		const char *pattern = NULL;
+		bool negate;
+
+		if (!xbps_array_get_cstring_nocopy(xhp->overwrite, i, &pattern) ||
+		    pattern == NULL)
+			continue;
+		if ((negate = *pattern == '!') || *pattern == '\\')
+			pattern++;
+		for (unsigned int j = 0; j < npaths; j++) {
+			if (fnmatch(pattern, paths[j], 0) == 0) {
+				match = !negate;
+				break;
+			}
+		}
+	}
+	return match;
+}
